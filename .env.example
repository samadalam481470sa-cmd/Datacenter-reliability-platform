# Default demo mode exposes only synthetic sample data, read-only API endpoints.
RACKHELM_MODE=demo
RACKHELM_DB_PATH=/tmp/rackhelm.db
# To permit importing telemetry or updating an incident, supply a private >=32-char value.
# RACKHELM_OPERATOR_KEY=generate-your-own-long-random-value
# RACKHELM_ALLOW_DEMO_INGEST=1 # LOCAL ONLY: allow test ingestion into PUBLIC synthetic demo. Never real data.
# RACKHELM_MODE=secure # protects all data read APIs as well as writes
# RACKHELM_ALLOWED_ORIGINS=https://your-trusted-console.example